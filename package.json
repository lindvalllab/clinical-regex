{
  "name": "clinical-regex",
  "author": {
    "name": "lindvalllab",
    "email": "lindvalllab@gmail.com"
  },
  "description": "Cross-platform desktop app for searching and annotating clinical texts.",
  "version": "1.0.7",
  "private": true,
  "dependencies": {
    "@chakra-ui/react": "^1.6.2",
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@fontsource/ibm-plex-mono": "^4.5.2",
    "@fontsource/ibm-plex-sans": "^4.5.2",
    "chakra-react-select": "^1.3.4",
    "flatten-overlapping-ranges": "^1.0.1",
    "formik": "^2.2.8",
    "framer-motion": "^4",
    "knex": "^1.0.4",
    "objection": "^2.2.15",
    "papaparse": "^5.3.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-icons": "^4.2.0",
    "react-router-dom": "^5.2.0",
    "react-scripts": "5.0.1",
    "react-select": "^4.3.1",
    "react-table": "^7.7.0",
    "sqlite3": "^5.1.7",
    "tinycolor2": "^1.4.2",
    "yup": "^0.32.9"
  },
  "homepage": "./",
  "main": "./build/electron/main.js",
  "build": {
    "appId": "com.electron.clinical-regex",
    "productName": "Clinical Regex",
    "extraMetadata": {
      "main": "build/electron/main.js"
    },
    "fileAssociations": [
      {
        "ext": "cr",
        "name": "Clinical Regex File",
        "mimeType": "application/x-sqlite3",
        "icon": "icon.png"
      }
    ],
    "afterSign": "./afterSignHook.js"
  },
  "scripts": {
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "start:react": "react-scripts start",
    "build:react": "react-scripts build",
    "test:react": "react-scripts test",
    "eject:react": "react-scripts eject",
    "tsc:electron": "tsc -p tsconfig.electron.json",
    "start:dev-server": "cross-env BROWSER=none react-scripts start",
    "start:dev-app": "wait-on http://localhost:3000 && yarn tsc:electron && electron .",
    "dev": "concurrently --kill-others \"yarn start:dev-server\" \"yarn start:dev-app\"",
    "build": "yarn build:react && yarn tsc:electron && electron-builder",
    "test": "yarn test:react",
    "lint": "eslint src --max-warnings 0",
    "tc": "tsc --noEmit -p tsconfig.json",
    "knex-cli": "TS_NODE_COMPILER_OPTIONS='{ \"module\": \"commonjs\" }' knex"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@testing-library/jest-dom": "^5.11.4",
    "@testing-library/react": "^11.1.0",
    "@testing-library/user-event": "^12.1.10",
    "@types/jest": "^26.0.15",
    "@types/knex": "^0.16.1",
    "@types/node": "^12.0.0",
    "@types/papaparse": "^5.2.5",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@types/react-icons": "^3.0.0",
    "@types/react-router-dom": "^5.1.7",
    "@types/react-select": "^4.0.15",
    "@types/react-table": "^7.7.1",
    "@types/sqlite3": "^3.1.7",
    "@types/styled-components": "^5.1.9",
    "auto": "^11",
    "concurrently": "^6.0.2",
    "cross-env": "^7.0.3",
    "electron": "^19.0.0",
    "electron-builder": "^23.0.2",
    "electron-devtools-installer": "^3.2.0",
    "eslint": "^7.25.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-prettier": "^3.4.0",
    "prettier": "^2.2.1",
    "source-map-explorer": "^2.5.2",
    "typescript": "^4.1.2",
    "wait-on": "^5.3.0"
  },
  "resolutions": {
    "styled-components": "^5"
  }
}
