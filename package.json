{
  "name": "clinical-regex",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.11.4",
    "@testing-library/react": "^11.1.0",
    "@testing-library/user-event": "^12.1.10",
    "@types/jest": "^26.0.15",
    "@types/node": "^12.0.0",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "knex": "^0.95.4",
    "objection": "^2.2.15",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-scripts": "4.0.3",
    "sqlite3": "^5.0.2",
    "typescript": "^4.1.2"
  },
  "homepage": "./",
  "main": "./build/main.js",
  "build": {
    "extraMetadata": {
      "main": "build/main.js"
    }
  },
  "scripts": {
    "start:react": "react-scripts start",
    "build:react": "react-scripts build",
    "test:react": "react-scripts test --roots electron src",
    "eject:react": "react-scripts eject",
    "tsc:electron": "tsc -p tsconfig.electron.json",
    "start:dev-server": "cross-env BROWSER=none react-scripts start",
    "start:dev-app": "wait-on http://localhost:3000 && yarn tsc:electron && electron .",
    "start:dev": "concurrently \"yarn start:dev-server\" \"yarn start:dev-app\"",
    "build:electron": "yarn build:react && yarn tsc:electron && electron-builder",
    "lint": "eslint src"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/knex": "^0.16.1",
    "@types/sqlite3": "^3.1.7",
    "concurrently": "^6.0.2",
    "cross-env": "^7.0.3",
    "electron": "^12.0.5",
    "electron-builder": "^22.10.5",
    "eslint": "^7.25.0",
    "eslint-plugin-prettier": "^3.4.0",
    "prettier": "^2.2.1",
    "wait-on": "^5.3.0"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/electron/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/src/**/*.{spec,test}.{js,jsx,ts,tsx}",
      "<rootDir>/electron/**/*.{spec,test}.{js,jsx,ts,tsx}"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "electron/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts",
      "!electron/**/*.d.ts"
    ]
  }
}
